# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Competitor agent (web search); a low-cost reasoning model
COMPETITOR_MODEL=gpt-6-luna
# Demand agent (web search)
DEMAND_MODEL=gpt-6-luna

# --- Feasibility agent ---
# Local repo it reads (read-only); ARCHITECTURE.md there is used as the code map
CODEBASE_DIR=/Users/swati/projects/fitslot-app
FEASIBILITY_MODEL=gpt-6-luna
# Final go / no go decision from the three reports
DECISION_MODEL=gpt-6-luna
# Team used for the estimate; focused hours per person per day
TEAM_DEVS=1
TEAM_QA=1
HOURS_PER_DAY=5
# Optional: OpenAI-compatible endpoint (Azure, OpenRouter, Ollama, ...). Leave empty for api.openai.com
OPENAI_BASE_URL=

# --- Agent ---
AGENT_NAME=Research Assistant
# AGENT_INSTRUCTIONS="You are a helpful research assistant..."
OPENAI_AGENTS_DISABLE_TRACING=false

# --- Documents ---
# Folder (relative to project root, or absolute) containing PDFs / text files
DOCS_DIR=docs
# Max characters returned per document read
MAX_DOC_CHARS=50000

# --- Gradio ---
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7861
GRADIO_SHARE=false
